{
  "manifest_version": 3,
  "name": "Snypar Resdex Auto-Fill Bot",
  "version": "1.0",
  "description": "Automatically fills Naukri Resdex candidate search criteria from Snypar Profile Bot",
  "host_permissions": [
    "*://resdex.naukri.com/*",
    "http://localhost:8001/*",
    "http://127.0.0.1:8001/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://resdex.naukri.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Snypar Resdex Bot"
  }
}
