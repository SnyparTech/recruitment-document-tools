{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ResdexFormSchema",
  "description": "Semantic schema definition of the Naukri Resdex candidate search form fields, types, and allowed options.",
  "sections": {
    "basic_search": {
      "title": "Basic Search",
      "fields": {
        "keywords": {
          "id": "keywords",
          "label": "Keywords",
          "type": "dynamic_multiselect",
          "description": "Skills and technical search keywords",
          "properties": {
            "required": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Mandatory skills (automatically selected with star ⭐ on keyword chips in portal)"
            },
            "preferred": { "type": "array", "items": { "type": "string" }, "description": "Preferred/optional skills" },
            "excluded": { "type": "array", "items": { "type": "string" }, "description": "Keywords to exclude" },
            "mandatory": {
              "type": "boolean",
              "default": true,
              "description": "Mark all keywords as mandatory and select mandatory star ⭐"
            },
            "auto_star_mandatory": {
              "type": "boolean",
              "default": true,
              "description": "Automatically select the star for mandatory skills in keyword chips"
            },
            "search_scope": {
              "type": "select",
              "options": ["Entire resume", "Resume title", "Key skills", "Resume title and Key skills"],
              "default": "Entire resume"
            }
          }
        },
        "min_experience": {
          "id": "min_experience",
          "label": "Minimum Experience",
          "type": "number",
          "min": 0,
          "max": 50,
          "description": "Minimum years of professional experience"
        },
        "max_experience": {
          "id": "max_experience",
          "label": "Maximum Experience",
          "type": "number",
          "min": 0,
          "max": 50,
          "description": "Maximum years of professional experience"
        },
        "current_location": {
          "id": "current_location",
          "label": "Current Location",
          "type": "multiselect",
          "description": "Current city location of candidate",
          "options": [
            "Hyderabad", "Bengaluru", "Pune", "Delhi NCR", "Delhi", "Noida", "Gurgaon", "Gurugram",
            "Chennai", "Mumbai", "Kolkata", "Ahmedabad", "Kochi", "Chandigarh", "Jaipur", "Indore", "Coimbatore"
          ],
          "extensible": true
        },
        "include_relocation": {
          "id": "include_relocation",
          "label": "Include candidates who prefer to relocate",
          "type": "checkbox",
          "description": "Include candidates willing to relocate to target location"
        },
        "exclude_anywhere_location": {
          "id": "exclude_anywhere_location",
          "label": "Exclude candidates who mentioned Anywhere",
          "type": "checkbox",
          "description": "Exclude candidates who selected anywhere in location preferences"
        },
        "salary": {
          "id": "salary",
          "label": "Annual Salary",
          "type": "range",
          "properties": {
            "currency": {
              "type": "select",
              "options": ["INR", "USD", "EUR", "AED", "GBP"],
              "default": "INR"
            },
            "min": { "type": "number", "description": "Minimum annual salary in lakhs (or currency units)" },
            "max": { "type": "number", "description": "Maximum annual salary in lakhs (or currency units)" },
            "include_unspecified": { "type": "boolean", "description": "Include candidates without current salary" }
          }
        }
      }
    },
    "employment_details": {
      "title": "Employment Details",
      "fields": {
        "department_role": {
          "id": "department_role",
          "label": "Department and Role",
          "type": "search_select",
          "description": "Functional department and specific role categories",
          "extensible": true
        },
        "industry": {
          "id": "industry",
          "label": "Industry",
          "type": "search_select",
          "description": "Candidate industry sector",
          "extensible": true
        },
        "company": {
          "id": "company",
          "label": "Company",
          "type": "search_select",
          "description": "Target company name",
          "extensible": true
        },
        "company_search_scope": {
          "id": "company_search_scope",
          "label": "Company search scope",
          "type": "select",
          "options": ["Current company", "Previous company", "Current/Previous company"],
          "default": "Current company"
        },
        "exclude_company": {
          "id": "exclude_company",
          "label": "Exclude Company",
          "type": "search_select",
          "description": "Companies to exclude",
          "extensible": true
        },
        "exclude_company_search_scope": {
          "id": "exclude_company_search_scope",
          "label": "Exclude Company search scope",
          "type": "select",
          "options": ["Current company", "Previous company", "Current/Previous company"],
          "default": "Current company"
        },
        "designation": {
          "id": "designation",
          "label": "Designation",
          "type": "dynamic_multiselect",
          "description": "Candidate job titles/designations",
          "extensible": true
        },
        "designation_search_scope": {
          "id": "designation_search_scope",
          "label": "Designation search scope",
          "type": "select",
          "options": ["Current designation", "Previous designation", "Current/Previous designation"],
          "default": "Current designation"
        }
      }
    },
    "notice_period": {
      "title": "Notice Period",
      "fields": {
        "notice_period": {
          "id": "notice_period",
          "label": "Notice Period",
          "type": "multiselect",
          "options": [
            "Any",
            "0-15 days",
            "1 month",
            "2 months",
            "3 months",
            "More than 3 months",
            "Currently serving notice period"
          ]
        }
      }
    },
    "diversity_hiring": {
      "title": "Diversity Hiring",
      "fields": {
        "gender": {
          "id": "gender",
          "label": "Gender",
          "type": "select",
          "options": ["All candidates", "Male candidates", "Female candidates"]
        },
        "career_break": {
          "id": "career_break",
          "label": "Career break",
          "type": "select",
          "options": ["Women returning to work"]
        },
        "differently_abled": {
          "id": "differently_abled",
          "label": "Differently-abled",
          "type": "select",
          "options": [
            "Any",
            "Blindness",
            "Low Vision",
            "Hearing Impairment",
            "Speech and Language Disability",
            "Locomotor Disability",
            "Other"
          ]
        },
        "defence_background": {
          "id": "defence_background",
          "label": "Defence background",
          "type": "select",
          "options": ["Any", "Army", "Navy", "Air Force", "Other Paramilitary Forces"]
        }
      }
    },
    "additional_details": {
      "title": "Additional Details",
      "fields": {
        "candidate_category": {
          "id": "candidate_category",
          "label": "Candidate Category",
          "type": "select",
          "options": [
            "Scheduled Caste (SC)",
            "Scheduled Tribe (ST)",
            "OBC - Creamy",
            "OBC - Non Creamy",
            "Other"
          ]
        },
        "candidate_age": {
          "id": "candidate_age",
          "label": "Candidate Age",
          "type": "range",
          "properties": {
            "min": { "type": "number", "min": 18, "max": 65 },
            "max": { "type": "number", "min": 18, "max": 65 }
          }
        },
        "job_type": {
          "id": "job_type",
          "label": "Job type",
          "type": "select",
          "options": ["Any", "Permanent", "Temporary/Contract job"]
        },
        "employment_type": {
          "id": "employment_type",
          "label": "Employment type",
          "type": "select",
          "options": ["Any", "Full time", "Part time"]
        },
        "work_permit": {
          "id": "work_permit",
          "label": "Work permit",
          "type": "multiselect",
          "options": [
            "United States",
            "India",
            "Australia",
            "Bahrain",
            "Bangladesh",
            "Belgium",
            "Canada"
          ],
          "extensible": true
        }
      }
    },
    "display_details": {
      "title": "Display Details",
      "fields": {
        "candidate_display": {
          "id": "candidate_display",
          "label": "Show",
          "type": "select",
          "options": ["All candidates", "Modified candidates"],
          "default": "All candidates"
        },
        "verified_mobile": {
          "id": "verified_mobile",
          "label": "Verified mobile number",
          "type": "checkbox",
          "default": true,
          "description": "Show only candidates with verified mobile number (automatically checked)"
        },
        "verified_email": {
          "id": "verified_email",
          "label": "Verified email ID",
          "type": "checkbox",
          "default": true,
          "description": "Show only candidates with verified email ID (automatically checked)"
        },
        "attached_resume": {
          "id": "attached_resume",
          "label": "Attached resume",
          "type": "checkbox",
          "default": true,
          "description": "Show only candidates with attached resume (automatically checked)"
        }
      }
    },
    "search_active_period": {
      "title": "Search Active Period",
      "description": "Active in status (dynamically cycles through: 15 days -> 30 days -> 2 months -> 3 months -> 6 months)",
      "fields": {
        "active_in": {
          "id": "active_in",
          "label": "Search Active Period",
          "type": "select",
          "options": [
            "3 days",
            "7 days",
            "15 days",
            "30 days",
            "2 months",
            "3 months",
            "6 months"
          ],
          "default": "15 days",
          "active_in_tiers": [
            "15 days",
            "30 days",
            "2 months",
            "3 months",
            "6 months"
          ],
          "description": "Active in status dynamically changes on Next Top Candidates (default: 15 days)"
        }
      }
    }
  }
}
