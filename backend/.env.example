# LLM Configuration for AI HR Recruiter Agent
# Supported Providers: Groq or Google Gemini (OpenAI removed)

# Option 1: Groq (Free & Instant from https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=

# Option 2: Google Gemini (Free & High Quality from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=

# --------------------------------------------------------------------------
# Recruitment JD -> WhatsApp pipeline
# --------------------------------------------------------------------------

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=profile_bot_recruitment

# Gmail API (OAuth2 "Desktop app" client, from Google Cloud Console)
# Files below are local-only and gitignored — never commit them.
GMAIL_CLIENT_SECRETS_FILE=gmail_credentials.json
GMAIL_TOKEN_FILE=gmail_token.json
GMAIL_LABEL=
GMAIL_QUERY=is:unread

# JD extraction model (reuses GROQ_API_KEY above)
JD_EXTRACTION_MODEL=openai/gpt-oss-20b

# Meta WhatsApp Business Platform (Cloud API) — official credentials only.
# Get these from the Meta for Developers app dashboard (WhatsApp product).
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_BUSINESS_ACCOUNT_ID=
META_API_VERSION=v19.0
META_WEBHOOK_VERIFY_TOKEN=

# Comma-separated E.164 numbers. The Cloud API has no WhatsApp Group
# create/post endpoint — this is the officially-supported substitute
# (individual broadcast) — see app/services/meta_whatsapp_service.py.
WHATSAPP_BROADCAST_RECIPIENTS=

# Optional: a pre-approved template name/language for business-initiated
# sends outside a customer's 24h session window. If unset, falls back to a
# plain text session message (only delivers within an open 24h window).
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# Safety defaults — keep SEND_WHATSAPP=false until you've verified the full
# pipeline end-to-end via /docs (Swagger). Everything up to the actual Meta
# API call still runs and is testable in dry-run mode.
SEND_WHATSAPP=false
WHATSAPP_MAX_MESSAGES_PER_HOUR=20
WHATSAPP_MESSAGE_MAX_CHARS=4096
